{
    "hosting": {
        "public": ".",
        "ignore": [
            "firebase.json",
            "database.rules.json",
            "**/.*",
            "**/.*/**",
            "**/node_modules/**",
            "*.bat",
            "update_version.js",
            "monitor_deployment.js",
            "temp_*",
            "agent.md",
            "index-IMW1042835C.html",
            "icons/icons.pptx",
            "package.json",
            "package-lock.json"
        ],
        "headers": [
            {
                "source": "**/*.@(html|js|css|json)",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "no-cache"
                    }
                ]
            },
            {
                "source": "**/*.@(svg|png|mp3)",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "public, max-age=31536000, immutable"
                    }
                ]
            }
        ]
    },
    "database": {
        "rules": "database.rules.json"
    }
}
